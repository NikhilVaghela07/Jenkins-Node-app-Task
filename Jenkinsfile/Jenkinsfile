node('remote-node') {
    properties([
        parameters([
            gitParameter(
                type: 'PT_BRANCH', 
                name: 'A_BRANCH', 
                branchFilter: 'origin/(.*)', 
                defaultValue: 'main', 
                description: 'Choose a branch for checkout', 
                selectedValue: 'DEFAULT', 
                sortMode: 'ASCENDING_SMART'
            ), 
            booleanParam(
                name: 'DEPLOY_PROD', 
                defaultValue: false, 
                description: 'Select if you want to deploy to production'
            )
        ])
    ])

    stage('Checkout') {
        echo 'Cleaning workspace and checking out source code...'
        cleanWs() 
        git url: "https://github.com/NikhilVaghela07/Jenkins-Node-app-Task.git", branch: params.A_BRANCH
        echo "${params.A_BRANCH}"
    }

    nodejs(nodeJSInstallationName: 'NODE_JS') {
        stage('Install Node Js') {
            sh 'node -v'
            sh 'npm -v'
        }

        stage('Build & Install Dependencies') {
            echo 'installing dependencies.'
            sh 'npm install'
            sh 'npm list -g pm2 || npm install pm2 -g' 
        }
        
        stage("Build app and check Required dependency") {
            withEnv(["GIT_BRANCH=${params.A_BRANCH}", "JENKINS_NODE_COOKIE=dontKillMe"]) {
                sh '''
                    if pm2 list | grep -q "NODE-APP"; then
                        echo "Application is running. Stopping and deleting old instance to load fresh files..."
                        pm2 delete NODE-APP
                    fi
                    
                    echo "Starting application with latest fetched code..."
                    pm2 start server.js --name "NODE-APP" --update-env
                '''
            }
            echo "Application Started Successfully"
        }
    }

    stage('Test') {
        echo 'Running tests...'
    }

    if (params.DEPLOY_PROD) {
        stage('Deploy') {
            echo 'Deploying application...'
        }
    } else {
        echo 'Deployment stage skipped.'
    }
}
