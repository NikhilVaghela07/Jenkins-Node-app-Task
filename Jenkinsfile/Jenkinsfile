properties([
        parameters([
            gitParameter(
                type: 'PT_BRANCH', 
                name: 'A_BRANCH', 
                branchFilter: 'origin/(.*)', 
                defaultValue: 'main', 
                description: 'Choose a branch for checkout', 
                selectedValue: 'DEFAULT', 
                sortMode: 'ASCENDING_SMART'
            ), 
            booleanParam(
                name: 'DEPLOY_PROD', 
                defaultValue: false, 
                description: 'Select if you want to deploy to production'
            )
        ]),
        pipelineTriggers([
            [$class: 'GenericTrigger',
                genericVariables: [
                    [key: 'WEBHOOK_BRANCH', value: '$.ref']
                ],
                causeString: 'Triggered by a push to $WEBHOOK_BRANCH',
                tokenCredentialId: 'generic-webhook-token',
                printContributedVariables: false,
                printPostContent: false,
                regexpFilterText: '$WEBHOOK_BRANCH',
                regexpFilterExpression: '^refs/heads/.+$'
            ]
        ])
    ])

node('remote-node') {

    stage('Checkout') {
        echo 'Cleaning workspace and checking out source code...'
        cleanWs()
        def checkoutBranch = env.WEBHOOK_BRANCH
            ? env.WEBHOOK_BRANCH.replaceFirst('^refs/heads/', '')
            : params.A_BRANCH
        git url: "https://github.com/NikhilVaghela07/Jenkins-Node-app-Task.git", branch: checkoutBranch
        echo "Current Branch: ${checkoutBranch}"
    }

    nodejs(nodeJSInstallationName: 'NODE_JS') {
        stage('Install Node Js') {
            sh 'node -v'
            sh 'npm -v'
        }

        stage('Build & Install Dependencies') {
            echo 'installing dependencies.'
            sh 'npm install'
            sh 'npm list -g pm2 || npm install pm2 -g' 
        }
        
    }

    stage('Test') {
        echo 'Running syntax and smoke tests...'
        sh 'node --check server.js'
        echo "Tests completed successfully."
    }

    if (params.DEPLOY_PROD) {
        stage('Deploy') {
            withEnv(["GIT_BRANCH=${params.A_BRANCH}", "JENKINS_NODE_COOKIE=dontKillMe"]) {
                sh '''
                    if pm2 list | grep -q "NODE-APP"; then
                        pm2 delete NODE-APP
                    fi

                    pm2 start server.js --name "NODE-APP" --update-env
                    pm2 save
                '''
            }
            echo 'Application deployed successfully.'
        }
    } else {
        echo 'Deployment stage skipped.'
    }
}
